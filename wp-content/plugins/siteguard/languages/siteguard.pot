#: admin/siteguard-menu-rename-login.php:90
msgid ""
"%s cannot be used for the new login path because it conflicts with an "
"existing file or directory in the WordPress root."
msgstr ""

#: admin/siteguard-menu-rename-login.php:137
msgid ""
"ERROR: Failed to enable. WordPress cannot create the required file in the "
"site root."
msgstr ""

#: admin/siteguard-menu-rename-login.php:138
msgid ""
"Please check that the WordPress root directory is writable, or contact your "
"hosting provider."
msgstr ""

#: admin/siteguard-menu-rename-login.php:169
#: admin/siteguard-menu-rename-login.php:177
#: admin/siteguard-menu-rename-login.php:185
msgid "Login URL:"
msgstr ""

#: admin/siteguard-menu-rename-login.php:171
msgid ""
"The login URL ends with .php because this server does not support .htaccess."
msgstr ""

#: admin/siteguard-menu-rename-login.php:187
msgid "This feature is currently off."
msgstr ""

#: admin/siteguard-menu-rename-login.php:205
msgid "Reason: the server is Nginx, which does not use .htaccess."
msgstr ""

#: admin/siteguard-menu-rename-login.php:207
msgid "Reason: the server is not Apache/LiteSpeed, so .htaccess is not used."
msgstr ""

#: admin/siteguard-menu-rename-login.php:209
msgid ""
"Reason: the .htaccess file (or the WordPress directory) is not writable."
msgstr ""

#: admin/siteguard-menu-rename-login.php:211
msgid ""
"Reason: a temporary test directory could not be created in the WordPress "
"directory (check write permission)."
msgstr ""

#: admin/siteguard-menu-rename-login.php:213
msgid "Reason: the temporary test files could not be written."
msgstr ""

#. translators: %s: test URL
#: admin/siteguard-menu-rename-login.php:217
msgid ""
"Reason: the .htaccess file is present but the server is ignoring it (for "
"example AllowOverride is set to None, or mod_rewrite is not enabled for this "
"directory), so the rewrite for %s had no effect."
msgstr ""

#. translators: 1: test URL, 2: error message
#: admin/siteguard-menu-rename-login.php:223
msgid ""
"Reason: the self-test request to %1$s failed (%2$s). The server may be "
"unable to reach its own URL (loopback)."
msgstr ""

#: admin/siteguard-menu-rename-login.php:230
msgid ""
"It may be blocked by an access restriction such as Basic authentication or "
"an IP restriction."
msgstr ""

#: admin/siteguard-menu-rename-login.php:232
msgid ""
"The test URL was not found, for example because WordPress is installed in a "
"subdirectory so the self-test URL does not map to it, or the request is "
"routed elsewhere."
msgstr ""

#: admin/siteguard-menu-rename-login.php:234
msgid ""
"The request was rate-limited or temporarily blocked. This is usually a "
"server-side rate limit or anti-bot/access-control protection (separate from ."
"htaccess), not a sign that .htaccess is broken. Try again after a short "
"while."
msgstr ""

#: admin/siteguard-menu-rename-login.php:236
msgid ""
"The request was redirected (for example HTTP to HTTPS, or a canonical "
"redirect)."
msgstr ""

#. translators: 1: test URL, 2: HTTP status code
#: admin/siteguard-menu-rename-login.php:242
msgid ""
"Reason: the self-test request to %1$s returned HTTP %2$s instead of 200."
msgstr ""

#. translators: %s: test URL
#: admin/siteguard-menu-rename-login.php:249
msgid ""
"Reason: the self-test request to %s did not return the expected result; the ."
"htaccess rewrite did not take effect (it may be disabled by AllowOverride or "
"overridden by another rule)."
msgstr ""

#: admin/siteguard-menu-rename-login.php:290
msgid "https://www.jp-secure.com/siteguard_wp_plugin_en/howto/rename_login/"
msgstr ""

#: admin/siteguard-menu-rename-login.php:314
msgid ""
"Works automatically on most servers. If activation fails, please check file "
"permissions or contact your hosting provider."
msgstr ""

#: admin/siteguard-menu-rename-login.php:319
msgid "New Login Path"
msgstr ""

#: admin/siteguard-menu-rename-login.php:332
msgid "The actual login URL will include .php at the end."
msgstr ""

#: admin/siteguard-menu-rename-login.php:334
msgid "Letters, numbers, hyphens, and underscores only."
msgstr ""

#: admin/siteguard-menu-rename-login.php:344
msgid "Do not redirect from the admin page to the login page."
msgstr ""

#: admin/siteguard-menu-rename-login.php:348
msgid "Enable login rescue"
msgstr ""

#: admin/siteguard-menu-rename-login.php:349
